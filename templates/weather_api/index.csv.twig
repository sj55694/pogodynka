{% autoescape false -%}city,country,date,celsius,fahrenheit
{% for measurement in measurements -%}"{{ city|replace({'"': '""'}) }}","{{ country|replace({'"': '""'}) }}","{{ (measurement.date ?? '')|replace({'"': '""'}) }}","{{ (measurement.celsius ?? '')|replace({'"': '""'}) }}","{{ (measurement.fahrenheit ?? '')|replace({'"': '""'}) }}"{% if not loop.last %}{{ "\r\n" }}{% endif %}
{%- endfor -%}{%- endautoescape -%}
